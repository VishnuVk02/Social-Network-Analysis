# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/social_analytics?schema=public"

# Authentication & Security
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN=24h

# YouTube Data API v3 Credentials
YOUTUBE_API_KEY="your_youtube_api_key_here"
YOUTUBE_BASE_URL="https://www.googleapis.com/youtube/v3"

# GitHub REST API Credentials
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_TOKEN="your_github_personal_access_token_here"

# Reddit OAuth API Credentials (Optional: public endpoint fallbacks supported)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:soci-metrics-analytics:v1.0 (by /u/your_reddit_username)"
REDDIT_BASE_URL="https://www.reddit.com"

